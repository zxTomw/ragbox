{
  "name": "duckdb-opfs-lab",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": "^22.12.0 || >=24.0.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5173 --strictPort",
    "build": "npm run typecheck && vite build",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.worker.json && tsc -p tsconfig.test.json && tsc -p tsconfig.node.json && tsc -p tsconfig.e2e.json",
    "test": "vitest run",
    "test:browser": "playwright test",
    "check:deployment": "node --import tsx scripts/check-deployment.ts",
    "prepare:nfcorpus": "node --import tsx scripts/prepare-nfcorpus.ts"
  },
  "dependencies": {
    "@duckdb/duckdb-wasm": "1.32.0",
    "@fontsource/dm-sans": "^5.3.0",
    "@fontsource/instrument-serif": "^5.3.0",
    "@gsap/react": "^2.1.2",
    "@huggingface/transformers": "4.2.0",
    "gsap": "^3.15.0",
    "lucide": "1.59.0",
    "lucide-react": "^1.60.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^22.20.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@webgpu/types": "^0.1.74",
    "jsdom": "^30.1.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vitest": "4.1.11"
  }
}
